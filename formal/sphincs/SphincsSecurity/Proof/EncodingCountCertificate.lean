import SphincsSecurity.Proof.Prelude
import SphincsSecurity.Proof.EncodingComplementCount

namespace SphincsSecurity.TargetSum

set_option maxRecDepth 2000
set_option maxHeartbeats 2000000

private def row0 : List Nat := 1 :: List.replicate 96 0

private theorem row0_correct (total : Nat) (_htotal : total < 97) :
    row0.getD total 0 = digitSumCount 0 total := by
  rw [digitSumCount_zero]
  cases total with
  | zero => rfl
  | succ total =>
      have hlt : total < 96 := by omega
      change (List.replicate 96 0).getD total 0 = 0
      rw [List.getD_eq_getElem?_getD, List.getElem?_replicate_of_lt hlt]
      rfl

